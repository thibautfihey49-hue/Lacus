<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☁️ MEGA Sync Auto"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/folderBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📁 Choisir un dossier à sauvegarder"
        android:padding="16dp"
        android:background="#666666"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/folderPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aucun dossier sélectionné"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/uploadBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📤 Envoyer tout vers MEGA"
        android:textSize="18sp"
        android:padding="20dp"
        android:background="#D9272E"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="✅ Prêt — Choisis un dossier puis clique sur Envoyer"
        android:textSize="14sp"
        android:padding="16dp"
        android:background="#F5F5F5"
        android:gravity="top"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Comment ça marche :\n1. Choisis ton dossier\n2. Clique sur Envoyer\n3. Sélectionne MEGA dans la liste\n4. Les fichiers s'uploadent dans ton compte MEGA"
        android:textSize="12sp"
        android:textColor="#888888"
        android:padding="12dp"
        android:layout_marginTop="16dp"/>

</LinearLayout>
